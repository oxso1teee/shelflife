# ShelfLife monorepo. web/ and bot/ keep their own .gitignore files as well.

# Secrets: copy .env.example to .env and fill it in locally
.env
.env.*
!.env.example

# Runtime data: the SQLite database, uploaded logos, backups and their copies
/.data/
/.data.*/
/backups/
/.backups-drill/
*.db-journal
*.db-wal
*.db-shm

# Generated by the Docker build (web/includes/shelflife/asset_version.php)
/web/includes/shelflife/asset_revision.php

# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Editors, OS, logs
.idea/
.vscode/
.DS_Store
*.log
node_modules/
