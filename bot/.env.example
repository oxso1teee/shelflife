# Telegram bot token obtained from @BotFather, e.g. 123456789:AAE_your-token
# (in the ShelfLife deployment it comes from TELEGRAM_BOT_TOKEN in the top-level .env)
BOT_TOKEN=

# Base URL of the Wallos internal API, reachable from the bot only
WALLOS_INTERNAL_URL=http://web/api/internal/telegram

# Shared secret between the bot and Wallos, at least 32 characters
# (for example: openssl rand -hex 32). Wallos reads the same value.
SHELFLIFE_SERVICE_KEY=

# Time zone for "today" in /add (the same as the web app)
TZ=Europe/Moscow
