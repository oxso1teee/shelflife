# Copy to .env next to compose.yaml and fill in. Never commit .env.

# Time zone used by the web app, its cron jobs and the bot.
TZ=Europe/Moscow

# Local port the web app is published on (bound to 127.0.0.1 only).
WEB_PORT=8282

# The ShelfLife bot from @BotFather: its token and its username (without @).
# Left empty, the bot does not start and no reminders are sent.
# Format: TELEGRAM_BOT_TOKEN=123456789:AAE_your-token-from-BotFather
#         TELEGRAM_BOT_USERNAME=your_shelflife_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Shared secret between the bot and the web app, at least 32 characters.
# Generate one with: openssl rand -hex 32 (left empty, the bot's API is closed).
SHELFLIFE_SERVICE_KEY=

# Local hour (0-23) from which new reminders are sent each day.
SHELFLIFE_NOTIFY_HOUR=9

# Public domain of the site (an A record pointing at this server). Caddy gets
# the HTTPS certificate for it. The Telegram Login Widget needs this domain to
# be set for the bot in @BotFather (/setdomain). Example: shelflife.example.com
SHELFLIFE_DOMAIN=
